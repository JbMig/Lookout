# Copiez en .env.local (local) et renseignez les mêmes variables dans Vercel.
# Chaque service laissé vide tourne en « mode démo » (données fictives).

# --- Supabase (Project Settings > API) : base de données + comptes ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # serveur uniquement, jamais en NEXT_PUBLIC_

# --- Équipe Lookout : accès à l'administration (e-mails séparés par des virgules) ---
STAFF_EMAILS=

# --- Linkup : découverte des pages produits + extraction ---
LINKUP_API_KEY=
LINKUP_DEPTH=standard             # fast | standard | deep

# --- H Company : computer use ---
HAI_API_KEY=
HAI_BASE_URL=https://agp.eu.hcompany.ai/api/v2   # clé US : https://agp.hcompany.ai/api/v2
HAI_AGENT=h/web-surfer-flash
HAI_MAX_TIME_S=300

# --- Hugging Face : analyse rédigée, rapprochement, tendances ---
HF_TOKEN=
HF_MODEL=Qwen/Qwen2.5-72B-Instruct
HF_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
HF_TRENDS_DATASET=                # dataset de publications (vérifiez sa licence) ; vide = échantillon fictif
HF_TRENDS_CONFIG=default
HF_TRENDS_SPLIT=train

# --- Page Offres ---
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Démo : connexion en un clic ---
# Toujours active sans Supabase. Avec Supabase, mettez DEMO_LOGIN=true et un DEMO_PASSWORD
# (le compte DEMO_EMAIL est créé automatiquement). Désactivez-la après la présentation.
DEMO_LOGIN=
DEMO_EMAIL=demo@lookout.app
DEMO_PASSWORD=
